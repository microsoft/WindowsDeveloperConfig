# yaml-language-server: $schema=https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor: dscv3
resources:
  - name: VisualStudioBuildTools
    type: Microsoft.WinGet/Package
    properties:
      id: Microsoft.VisualStudio.2022.BuildTools
      source: winget
      acceptAgreements: true
    metadata:
      description: Install Visual Studio Build Tools for Triton JIT compilation
      winget:
        securityContext: elevated

  - name: VSBuildToolsArm64VCWorkload
    type: Microsoft.DSC.Transitional/RunCommandOnSet
    dependsOn:
      - VisualStudioBuildTools
    properties:
      executable: powershell
      arguments:
        "0": -NoProfile
        "1": -NoLogo
        "2": -Command
        "3": >-
          $ErrorActionPreference = 'Stop';
          $vswhere = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\Installer\vswhere.exe';
          $setup = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\Installer\setup.exe';
          if (-not (Test-Path $vswhere) -or -not (Test-Path $setup)) { throw 'Visual Studio Installer tools were not found.' };
          $installPath = & $vswhere -latest -products Microsoft.VisualStudio.Product.BuildTools -property installationPath;
          if (-not $installPath) { throw 'Visual Studio Build Tools installation path could not be determined.' };
          $proc = Start-Process -FilePath $setup -ArgumentList @('modify','--installPath',$installPath,'--channelId','VisualStudio.17.Release','--productId','Microsoft.VisualStudio.Product.BuildTools','--add','Microsoft.VisualStudio.Workload.VCTools','--add','Microsoft.VisualStudio.Component.VC.Tools.ARM64','--includeRecommended','--quiet','--norestart') -Wait -PassThru;
          if ($proc.ExitCode -ne 0 -and $proc.ExitCode -ne 3010) { throw "Visual Studio workload modification exited with code $($proc.ExitCode)" }
        treatAsArray: true
    metadata:
      description: Install the native ARM64 MSVC toolchain required by Triton
      winget:
        securityContext: elevated
